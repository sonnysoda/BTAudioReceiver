<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BTAudioReceiver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 背景保持透明，让 Mica 材质透出来 -->
    <Grid x:Name="RootGrid" Padding="20,18,20,16" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：当前使用中的音频设备 + 状态 -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                x:Name="ActiveDeviceText"
                Text="未连接"
                FontSize="18"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StateText"
                Text="使用中的音频设备 · 空闲"
                FontSize="12"
                Opacity="0.6" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Severity="Error"
            IsOpen="False"
            IsClosable="True" />

        <!-- 列表：一页最多 6 行（每行 56px），不足 6 行不出现滚动条 -->
        <Grid Grid.Row="2" VerticalAlignment="Top">
            <ListView
                x:Name="DeviceList"
                MaxHeight="344"
                VerticalAlignment="Top"
                SelectionMode="Single"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                CornerRadius="8"
                Padding="0,4" />

            <TextBlock
                x:Name="EmptyHint"
                Text="未发现可用设备&#x0a;请先在系统设置中配对手机"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                FontSize="13"
                Opacity="0.45"
                Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="SettingsButton"
                Grid.Column="0"
                Content="设置"
                Click="OnSettingsClick" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
                <Button x:Name="RefreshButton" Content="刷新" Click="OnRefreshClick" />
                <Button
                    x:Name="ConnectButton"
                    Content="连接"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnConnectClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
